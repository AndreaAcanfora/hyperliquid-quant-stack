{
  "name": "@andreaaca/trend-ensemble",
  "version": "0.1.0",
  "description": "Daily time-series-momentum ensemble: target-weight math, a portfolio backtester that runs in Node or the browser, and a shadow (paper) runner.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./shadow": { "types": "./dist/shadow.d.ts", "import": "./dist/shadow.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/AndreaAcanfora/hyperliquid-quant-stack", "directory": "packages/trend-ensemble" },
  "keywords": ["trend-following", "momentum", "backtest", "quant", "crypto"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
